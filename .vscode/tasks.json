{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compilar proyecto con libcaca",
            "type": "shell",
            "command": "C:/msys64/ucrt64/bin/g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${workspaceFolder}/*.cpp",
                "-o",
                "${workspaceFolder}/perriro_amarillo_franjas_naranjas_SO.exe",
                "-I", "${workspaceFolder}",
                "-lcaca"
            ],
            "options": {
                "env": {
                    "PATH": "C:/msys64/ucrt64/bin;${env:PATH}"
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}